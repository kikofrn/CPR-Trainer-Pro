{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main application window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-simple-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-available-monitors",
    "core:window:allow-current-monitor",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://ehacademy.com"
        },
        {
          "url": "https://ehacademy.com/login"
        },
        {
          "url": "https://ehacademy.hflip.co/InstructorOnboardingCPRAED"
        },
        {
          "url": "https://ehacademy.hflip.co/InstructorOnboardingFirstAid"
        },
        {
          "url": "mailto:info@ehacademy.com"
        }
      ]
    }
  ]
}
