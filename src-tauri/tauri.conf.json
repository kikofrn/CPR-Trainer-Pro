{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CPR Trainer Pro",
  "version": "2.0.0",
  "identifier": "com.ehacademy.cpr-trainer-pro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EH Academy — CPR Trainer Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Starting CPR Trainer Pro...",
        "url": "splash.html",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://media.localhost media: blob: data:; media-src 'self' http://media.localhost media: blob: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self' http://media.localhost media: https://fonts.googleapis.com https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/*": "media/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kikofrn/CPR-Trainer-Pro/releases/latest/download/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFNkNEMkVBMTE5MzI3QUQKUldTdEo1TVI2dEpzYnVzbmF1UURxM2k0a29KQWNqVTZWT0dGM296WTNhS2Y3RmYvbFFudDU2VHQK"
    }
  }
}
