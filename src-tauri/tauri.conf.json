{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CPRTrainerPro",
  "version": "2.3.2",
  "identifier": "com.ehacademy.cpr-trainer-pro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EH Academy — CPR Trainer Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Starting CPR Trainer Pro...",
        "url": "splash.html",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://media.localhost https://media.ehacademy.com media: blob: data:; media-src 'self' http://media.localhost media: blob: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self' http://media.localhost https://media.ehacademy.com media: https://fonts.googleapis.com https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/*": "media/"
    },
    "windows": {
      "nsis": {
        "installerIcon": "installer-icon.ico"
      }
    },
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "exceptionDomain": "media.localhost",
      "files": {
        "embedded.provisionprofile": "embedded.provisionprofile"
      }
    }
  }
}
