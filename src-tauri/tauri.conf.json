{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CPRTrainerPro",
  "version": "2.3.4",
  "identifier": "com.ehacademy.cpr-trainer-pro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EH Academy — CPR Trainer Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Starting CPR Trainer Pro...",
        "url": "splash.html",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://media.localhost https://media.ehacademy.com blob: data:; media-src 'self' http://media.localhost blob: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self' http://media.localhost https://media.ehacademy.com https://fonts.googleapis.com https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/*": "media/"
    },
    "windows": {
      "signCommand": "trusted-signing-cli -e https://ncus.codesigning.azure.net -a EHA-Artifact-Signing -c eha-public-trust-certificate %1",
      "nsis": {
        "installerIcon": "installer-icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kikofrn/CPR-Trainer-Pro/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QUYzMzhBNjY2NjE0OTYKUldTV0ZHWm1pak92dGxlUWJta3kvL3J1RzBjNjV4azNzUk9OZW5RT2pRNGZTOXYxL2ZqeURpYSsK"
    }
  }
}
